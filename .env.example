# ─────────────────────────────────────────────────────────────────────────────
# SITECORE settings. Copy this file to ".env" and fill in your values.
# Never commit .env — it contains passwords.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://sitecore:CHANGE_ME@localhost:5432/sitecore"

# Separate database used only by the automated integration tests.
# It is wiped before every test run — never point it at real data.
TEST_DATABASE_URL="postgresql://sitecore:CHANGE_ME@localhost:5432/sitecore_test"

# How long a login lasts.
SESSION_IDLE_HOURS=8      # signed out after this many hours without activity
SESSION_MAX_DAYS=7        # always signed out after this many days

# ── Demo data (development only) ────────────────────────────────────────────
# true = `npm run db:seed` creates a demo company. Ignored in production.
SEED_DEMO=true
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=Sunrise@2026
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=Site@2026

# ── Maps ────────────────────────────────────────────────────────────────────
# Map tiles (OpenStreetMap by default — no key needed).
# NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors"
# Also list construction shops from OpenStreetMap on the project map (public API).
MAPS_OVERPASS_ENABLED=false

# Log every database query to the console (debugging only).
PRISMA_LOG_QUERIES=false
